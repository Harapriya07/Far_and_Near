# Copy to backend/.env and replace all placeholders locally. Never commit real secrets.
APP_ENV=development
APP_NAME=Far & Near API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://far_near:replace_me@localhost:5432/far_and_near
FRONTEND_ORIGINS=http://localhost:5173

# Generate a unique random secret of at least 32 bytes, e.g. with Python secrets.token_urlsafe(48).
ACCESS_TOKEN_SECRET=replace_with_a_unique_random_secret_at_least_32_bytes
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=14
TOKEN_ISSUER=far-and-near
TOKEN_AUDIENCE=far-and-near-api

# Local HTTP development: Secure=false. Production HTTPS must use Secure=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
